{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "canvas/app/command-palette-items": ["../canvas/src/canvas/app/feature-packs/command-palette/CanvasCommandPaletteItems.ts"],
      "canvas/app/eraser-hit-testing": ["../canvas/src/canvas/app/affordances/interaction/pointer/CanvasEraserHitTesting.ts"],
      "canvas/app/pointer-drawing": ["../canvas/src/canvas/app/affordances/interaction/pointer/CanvasPointerDrawing.ts"],
      "canvas/app/image-clipboard": ["../canvas/src/canvas/app/feature-packs/image-io/CanvasImageClipboard.ts"],
      "canvas/app/image-import": ["../canvas/src/canvas/app/feature-packs/image-io/CanvasImageImport.ts"],
      "canvas/app/inline-edit-dom": ["../canvas/src/canvas/app/affordances/editing/text-editor/CanvasInlineEditDom.ts"],
      "canvas/app/keyboard-system-shortcuts": ["../canvas/src/canvas/app/affordances/interaction/keyboard/CanvasKeyboardSystemShortcuts.ts"],
      "canvas/app/media-import": ["../canvas/src/canvas/app/feature-packs/media-import/CanvasMediaImport.ts"],
      "canvas/app/minimap-model": ["../canvas/src/canvas/app/feature-packs/minimap/CanvasMinimapModel.ts"],
      "canvas/app/paste-position": ["../canvas/src/canvas/app/affordances/commands/CanvasPastePosition.ts"],
      "canvas/app/pointer-click-memory": ["../canvas/src/canvas/app/affordances/interaction/pointer/CanvasPointerClickMemory.ts"],
      "canvas/app/pointer-laser": ["../canvas/src/canvas/app/affordances/interaction/pointer/CanvasPointerLaser.ts"],
      "canvas/app/pointer-start-session": ["../canvas/src/canvas/app/affordances/interaction/pointer/CanvasPointerStartSession.ts"],
      "canvas/app/stage-element": ["../canvas/src/canvas/app/rendering/stage/CanvasAppStageElement.ts"],
      "canvas/app/table-import": ["../canvas/src/canvas/app/feature-packs/table-import/CanvasTableImport.ts"],
      "canvas/app/text-paste-import": ["../canvas/src/canvas/app/feature-packs/text-paste-import/CanvasTextPasteImport.ts"],
      "canvas/engine": ["../canvas/src/canvas/engine/index.ts"],
      "canvas/core": ["../canvas/src/canvas/core/index.ts"],
      "canvas/foundation": ["../canvas/src/canvas/foundation/index.ts"],
      "canvas/renderer/svg-drawing-primitives": ["../canvas/src/canvas/renderer/svg/CanvasSvgDrawingPrimitives.ts"],
      "@interactive-os/dom-edit-affordance/metadata": ["../canvas/packages/dom-edit-affordance/src/metadata.ts"],
      "@interactive-os/slide-edit-affordance": ["../canvas/packages/slide-edit-affordance/src/index.ts"]
    },
    "preserveSymlinks": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
